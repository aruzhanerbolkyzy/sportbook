# Подключение к PostgreSQL (замените логин, пароль и имя базы)
DATABASE_URL=postgresql://postgres:ПАРОЛЬ@localhost:5432/easykey

# Секрет подписи токенов: случайная строка не короче 32 символов
JWT_SECRET=замените_на_случайную_строку_от_32_символов
JWT_EXPIRES_IN=8h

# Адрес React-приложения (для настройки CORS)
CLIENT_URL=http://localhost:5173

PORT=4000
NODE_ENV=development

# Данные первого администратора для seed-скрипта (пароль задайте сами)
ADMIN_EMAIL=admin@easykey.kz
ADMIN_PASSWORD=
